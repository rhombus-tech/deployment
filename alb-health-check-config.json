{
  "TargetGroupArn": "arn:aws:elasticloadbalancing:region:account:targetgroup/zk-evm-targets/1234567890abcdef",
  "HealthCheckConfig": {
    "Protocol": "HTTP",
    "Port": "8080",
    "Path": "/status",
    "IntervalSeconds": 30,
    "TimeoutSeconds": 10,
    "HealthyThresholdCount": 2,
    "UnhealthyThresholdCount": 3,
    "Matcher": {
      "HttpCode": "200"
    }
  },
  "DeregistrationDelay": 30
}
