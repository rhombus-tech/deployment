# ZODA-WARP zkEVM Block Fix Update
# Building on proven architecture with just live_proving_service.rs updates

# Build stage
FROM rust:1.81-slim-bullseye AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libclang-dev \
    clang \
    cmake \
    build-essential \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Copy entire evm-verify project (including updated live_proving_service.rs)
COPY evm-verify/ ./
# Copy demo-playground files for embedding
COPY demo-playground/ ./demo-playground/

# Build production binaries with optimizations
RUN cargo build --release --bin live-proving-service

# Runtime stage
FROM debian:bullseye-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    jq \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for security
RUN groupadd -r zkvm && useradd -r -g zkvm zkvm

# Create app directory and set permissions
WORKDIR /app
RUN chown -R zkvm:zkvm /app

# Copy binaries from builder stage
COPY --from=builder /app/target/release/live-proving-service ./bin/live-proving-service
RUN chmod +x ./bin/live-proving-service

# Switch to non-root user
USER zkvm

# Expose port
EXPOSE 3030

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:3030/health || exit 1

# Start the live proving service
CMD ["./bin/live-proving-service"]
