# zkEVM Proving Infrastructure - Production Configuration
# Integrated with FRAC RPC for optimal performance and cost

# ============================================
# RPC CONFIGURATION - Uses FRAC RPC Gateway
# ============================================
# Primary: FRAC RPC (your infrastructure + smart fallbacks)
ETH_RPC_URL=http://localhost:8545
ETHEREUM_RPC_URL=http://localhost:8545
ZKVM_RPC_URL=http://localhost:8545

# Alternative if running FRAC RPC on different host
# ETH_RPC_URL=http://your-frac-rpc-host:8545

# WebSocket (for real-time subscriptions)
ETHEREUM_WS_URL=ws://localhost:8545/ws

# ============================================
# PROVING CONFIGURATION
# ============================================
# Enable security analysis during proving
ENABLE_SECURITY_ANALYSIS=true

# Vulnerability detection cache
ENABLE_VULNERABILITY_CACHE=true
CACHE_HIT_TARGET=0.90

# ============================================
# PERFORMANCE SETTINGS
# ============================================
# Number of parallel provers
PROVER_THREADS=8

# Batch size for block proving
PROVING_BATCH_SIZE=10

# Maximum blocks to process per session
MAX_BLOCKS_PER_SESSION=1000

# ============================================
# SERVICE CONFIGURATION
# ============================================
# Service bind address
SERVICE_BIND_ADDRESS=0.0.0.0:8080

# Enable external API for monitoring
ENABLE_EXTERNAL_API=true

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
RUST_LOG=info

# ============================================
# MONITORING
# ============================================
# Prometheus metrics
METRICS_ENABLED=true
METRICS_PORT=9091

# Performance tracking
TRACK_PROVING_PERFORMANCE=true
