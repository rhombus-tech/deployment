#[cfg(test)]
mod tests {
    use super::*;
    use hex_literal::hex;

    #[test]
    fn test_control_flow_graph_basic() {
        // Sample bytecode with a simple if-else pattern
        // PUSH1 0x01
        // PUSH1 0x02
        // EQ       // Compare if equal
        // PUSH1 0x0a // Jump destination if true (to JUMPDEST at offset 10)
        // JUMPI     // Conditional jump
        // PUSH1 0x00 // This executes if condition is false
        // PUSH1 0x00
        // RETURN
        // JUMPDEST  // This is where we jump to if condition is true
        // PUSH1 0x01
        // PUSH1 0x00
        // RETURN
        let bytecode = Bytes::from(hex!("6001600214600a57600060005b600160f3"));
        
        let analyzer = BytecodeAnalyzer::new(bytecode);
        let cfg_result = analyzer.build_control_flow_graph();
        
        // Just verify that the CFG was built successfully
        assert!(cfg_result.is_ok(), "Failed to build control flow graph");
    }
}
