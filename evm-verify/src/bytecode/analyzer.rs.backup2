    /// Record memory allocation
    pub fn record_memory_allocation(&mut self, offset: U256, size: U256) -> Result<()> {
        self.memory_analyzer.record_allocation(offset, size, self.state.pc);
        Ok(())
    }

    /// Record memory access
    pub fn record_memory_access(&mut self, offset: U256, size: U256, write: bool, value: Option<U256>) -> Result<()> {
        self.memory_analyzer.record_access(offset, size, self.state.pc, write, value);
        Ok(())
    }

    /// Get memory analyzer
    pub fn get_memory(&self) -> &MemoryAnalyzer {
        &self.memory_analyzer
    }
    
    /// Get bytecode length
    pub fn bytecode_length(&self) -> usize {
        self.bytecode.len()
    }

    /// Record a memory copy operation
    pub fn record_memory_copy(
        &mut self,
        dest_offset: U256,
        source_offset: U256,
        size: U256,
    ) -> Result<()> {
        // Record the memory copy operation
        let _ = size; // Used for future analysis
        let _ = source_offset; // Used for future analysis
        let _ = dest_offset; // Used for future analysis
        
        // For now, we just record the memory access
        self.memory_analyzer.record_access(dest_offset, size, self.state.pc, true, None);
        self.memory_analyzer.record_access(source_offset, size, self.state.pc, false, None);
        
        Ok(())
    }

    /// Set test mode (disables some features for compatibility with tests)
    pub fn set_test_mode(&mut self, test_mode: bool) {
        self.test_mode = test_mode;
    }

    /// Check if test mode is enabled
    pub fn is_test_mode(&self) -> bool {
        self.test_mode
    }

    /// Get bytecode as a vector of bytes
    pub fn get_bytecode_vec(&self) -> Vec<u8> {
        self.bytecode.iter().copied().collect()
    }

    /// Build a control flow graph from the bytecode
    /// This is essential for formal verification as it allows us to analyze all possible execution paths
    fn build_control_flow_graph(&self) -> Result<ControlFlowGraph> {
        let bytecode = self.get_bytecode_vec();
        let mut cfg = ControlFlowGraph::new();
        let mut pc = 0;
        
        // First pass: identify all jump destinations
        while pc < bytecode.len() {
            if pc < bytecode.len() && bytecode[pc] == 0x5b { // JUMPDEST
                cfg.add_jump_destination(pc);
            }
            
            // Move to next instruction based on opcode size
            let opcode_size = self.get_opcode_size(pc, &bytecode);
            pc += opcode_size;
        }
        
        // Second pass: build basic blocks and edges
        pc = 0;
        let mut current_block = cfg.create_block(pc);
        
        while pc < bytecode.len() {
            if pc > 0 && cfg.is_jump_destination(pc) {
                // Start a new basic block at jump destinations
                current_block = cfg.create_block(pc);
            }
            
            let opcode = bytecode.get(pc).cloned().unwrap_or(0);
            
            match opcode {
                // Control flow changing opcodes
                0x56 => { // JUMP
                    // Add edges from current block to potential jump targets
                    // In formal verification, we consider all possible jump destinations
                    for dest in cfg.get_jump_destinations() {
                        cfg.add_edge(current_block, dest);
                    }
                    
                    // Start a new block after the jump
                    pc += 1;
                    if pc < bytecode.len() {
                        current_block = cfg.create_block(pc);
                    }
                },
                0x57 => { // JUMPI
                    // Add edges to all potential jump destinations (for formal verification)
                    for dest in cfg.get_jump_destinations() {
                        cfg.add_edge(current_block, dest);
                    }
                    
                    // Also add edge to the fall-through case
                    pc += 1;
                    if pc < bytecode.len() {
                        let next_block = cfg.create_block(pc);
                        cfg.add_edge(current_block, next_block);
                        current_block = next_block;
                    }
                },
                0x00 => { // STOP
                    // End of execution path
                    pc += 1;
                    if pc < bytecode.len() {
                        current_block = cfg.create_block(pc);
                    }
                },
                0xf3 | 0xfd | 0xfe => { // RETURN, REVERT, INVALID
                    // End of execution path
                    pc += 1;
                    if pc < bytecode.len() {
                        current_block = cfg.create_block(pc);
                    }
                },
                _ => {
                    // Regular instruction, continue in the same block
                    let opcode_size = self.get_opcode_size(pc, &bytecode);
                    pc += opcode_size;
                    
                    // If next instruction is a jump destination, end the current block
                    if pc < bytecode.len() && cfg.is_jump_destination(pc) {
                        let next_block = cfg.create_block(pc);
                        cfg.add_edge(current_block, next_block);
                        current_block = next_block;
                    }
                }
            }
        }
        
        Ok(cfg)
    }
    
    /// Determine the size of an opcode and its immediate data
    fn get_opcode_size(&self, pc: usize, bytecode: &[u8]) -> usize {
        if pc >= bytecode.len() {
            return 1; // Default to 1 if we're out of bounds
        }
        
        let opcode = bytecode[pc];
        
        // Handle PUSH instructions which have immediate data
        if opcode >= 0x60 && opcode <= 0x7f {
            let n = (opcode - 0x60) as usize + 1; // Number of bytes to push
            return 1 + n; // Opcode + immediate data
        }
        
        // All other instructions are 1 byte
        1
    }
    
    /// Extract delegate calls from the control flow graph analysis
    fn extract_delegate_calls(&self, cfg: &ControlFlowGraph) -> Vec<DelegateCall> {
        let bytecode = self.get_bytecode_vec();
        let mut delegate_calls = Vec::new();
        let mut call_id = 0;
        
        // Analyze each block in the control flow graph
        for block_id in cfg.get_blocks() {
            let block_start = block_id;
            let mut pc = block_start;
            
            // Analyze instructions in the block
            while pc < bytecode.len() {
                if pc >= bytecode.len() {
                    break;
                }
                
                let opcode = bytecode[pc];
                
                // Check for DELEGATECALL (0xf4) or CALLCODE (0xf2)
                // Both have delegated execution risks but with different context models
                if opcode == 0xf4 || opcode == 0xf2 {
                    // In a real implementation, we would analyze the stack to extract
                    // parameters like target, data offsets, etc.
                    // For now, create a basic entry
                    
                    // Set the call type based on the opcode
                    let call_type = match opcode {
                        0xf4 => "DELEGATECALL",
                        0xf2 => "CALLCODE",
                        _ => "UNKNOWN", // Should never happen due to our if condition above
                    }.to_string();
                    
                    delegate_calls.push(DelegateCall {
                        target: H160::zero(), // Would extract from stack analysis in real implementation
                        pc: pc as u64, // Convert usize to u64 for program counter
                        data_offset: U256::from(0), // Would extract from stack analysis
                        data_size: U256::from(32),  // Would extract from stack analysis
                        return_offset: U256::from(32), // Would extract from stack analysis
                        return_size: U256::from(32),   // Would extract from stack analysis
                        state_modifications: Vec::new(), // Would determine from storage analysis
                        parent_call_id: None, // Would determine from call graph analysis
                        child_call_ids: Vec::new(), // Would determine from call graph analysis
                        gas_limit: U256::from(32), // Would extract from stack analysis
                        gas_used: U256::zero(),    // Would calculate from execution analysis
                        depth: 0, // Would determine from call graph analysis
                        call_type: call_type, // Set based on the opcode
                    });
                    call_id += 1;
                }
                
                // Move to next instruction
                let opcode_size = self.get_opcode_size(pc, &bytecode);
                pc += opcode_size;
                
                // Stop if we've reached the end of this basic block
                if pc < bytecode.len() && cfg.is_jump_destination(pc) && pc != block_start {
                    break;
                }
            }
        }
        
        // Once we have all calls, we can build the call graph relationships
        // This is a simplified approach; a real implementation would analyze the
        // call sequence and relationships in detail
        
        delegate_calls
    }
    
    /// Extract external calls from the control flow graph analysis
    fn extract_external_calls(&self, cfg: &ControlFlowGraph) -> (Vec<ExternalCall>, Vec<SecurityWarning>) {
        let bytecode = self.get_bytecode_vec();
        let mut external_calls = Vec::new();
        let mut security_warnings = Vec::new();
        
        // Simulate stack operations for each block in the control flow graph
        for block_id in cfg.get_blocks() {
            let block_start = block_id;
            let mut pc = block_start;
            let mut stack = Vec::new(); // Stack simulator for this basic block
            
            // Analyze instructions in the block
            while pc < bytecode.len() {
                if pc >= bytecode.len() {
                    break;
                }
                
                let opcode = bytecode[pc];
                
                // Simulate basic stack operations to ensure we have valid state at external calls
                match opcode {
                    // PUSHx instructions
                    0x60..=0x7f => {
                        let n = (opcode - 0x60 + 1) as usize; // Number of bytes to push
                        let mut val = U256::zero();
                        for i in 0..n {
                            if pc + 1 + i < bytecode.len() {
                                val = (val << 8) | U256::from(bytecode[pc + 1 + i]);
                            }
                        }
                        stack.push(val);
                        pc += 1 + n;
                        continue;
                    },
                    
                    // DUP instructions
                    0x80..=0x8f => {
                        let n = (opcode - 0x80 + 1) as usize;
                        if stack.len() >= n {
                            let val = stack[stack.len() - n];
                            stack.push(val);
                        } else {
                            // Stack underflow - push default value
                            stack.push(U256::zero());
                        }
                    },
                    
                    // SWAP instructions
                    0x90..=0x9f => {
                        let n = (opcode - 0x90 + 1) as usize;
                        if stack.len() >= n + 1 {
                            let l = stack.len();
                            stack.swap(l - 1, l - n - 1);
                        }
                    },
                    
                    // POP instruction
                    0x50 => {
                        if !stack.is_empty() {
                            stack.pop();
                        }
                    },
                    
                    // External call instructions
                    0xf1 | 0xf2 | 0xfa => {
                        #[cfg(debug_assertions)]
                        {
                            println!("External call at PC {}: {} with stack depth {}", pc, 
                                match opcode {
                                    0xf1 => "CALL",
                                    0xf2 => "CALLCODE",
                                    0xfa => "STATICCALL",
                                    _ => "UNKNOWN",
                                }, stack.len());
                        }
                        
                        // Extract parameters from stack
                        // If stack doesn't have enough elements, use defaults
                        let gas = if stack.len() >= 1 { stack.pop().unwrap_or_default() } else { U256::from(32) };
                        let address = if stack.len() >= 1 { stack.pop().unwrap_or_default() } else { U256::zero() };
                        
                        // STATICCALL doesn't have value parameter
                        let value = if opcode != 0xfa {
                            if stack.len() >= 1 { stack.pop().unwrap_or_default() } else { U256::zero() }
                        } else {
                            U256::zero() // STATICCALL never transfers value
                        };
                        
                        let args_offset = if stack.len() >= 1 { stack.pop().unwrap_or_default() } else { U256::zero() };
                        let args_size = if stack.len() >= 1 { stack.pop().unwrap_or_default() } else { U256::from(32) };
                        let ret_offset = if stack.len() >= 1 { stack.pop().unwrap_or_default() } else { U256::zero() };
                        let ret_size = if stack.len() >= 1 { stack.pop().unwrap_or_default() } else { U256::from(32) };
                        
                        // Simulate memory operations
                        // In a full implementation we would extract actual call data from memory
                        
                        // Push success value (1) to the stack
                        stack.push(U256::one()); // Assume call succeeds
                        
                        // Create external call record with extracted parameters
                        let target_address = if address <= U256::from(u128::MAX) {
                            Some(H160::from_low_u64_be(address.as_u64()))
                        } else {
                            None
                        };
                        
                        external_calls.push(ExternalCall {
                            offset: pc, 
                            target: target_address,
                            value: value,
                            data: Bytes::default(), // Would need full memory simulation to extract real data
                            gas: gas,
                            call_type: match opcode {
                                0xf1 => "CALL".to_string(),
                                0xf2 => "CALLCODE".to_string(),
                                0xfa => "STATICCALL".to_string(),
                                _ => "UNKNOWN".to_string(),
                            },
                            is_known_contract: false,
                            is_potential_bridge: false,
                        });
                        
                        // Add security warnings for CALLCODE
                        if opcode == 0xf2 {
                            // CALLCODE is deprecated, flag this as a security issue
                            // Convert U256 to H256 for operation target
                            let mut bytes = [0u8; 32];
                            address.to_big_endian(&mut bytes);
                            let target_h256 = H256::from(bytes);
                            
                            let call_operation = Operation::DelegateCall {
                                target: target_h256,
                                data: Bytes::default().to_vec(),
                            };
                            
                            let warning = SecurityWarning {
                                kind: SecurityWarningKind::DelegateCallMisuse,
                                severity: SecuritySeverity::High,
                                pc: pc as u64,
                                description: format!(
                                    "Use of deprecated CALLCODE opcode at PC {}. CALLCODE has been deprecated since the Byzantium fork as it doesn't preserve msg.sender and msg.value properly.", 
                                    pc
                                ),
                                operations: vec![call_operation],
                                remediation: String::from(
                                    "Replace CALLCODE with DELEGATECALL which properly preserves context, or with a direct CALL if context preservation is not needed. CALLCODE has been deprecated since Ethereum's Byzantium fork."
                                ),
                            };
                            
                            security_warnings.push(warning);
                            
                            #[cfg(debug_assertions)]
                            {
                                println!("WARNING: Use of deprecated CALLCODE opcode at PC {}", pc);
                            }
                        }
                    },
                    
                    _ => {}
                }
                
                // Move to next instruction for non-PUSHx opcodes
                if !(opcode >= 0x60 && opcode <= 0x7f) {
                    pc += 1;
                }
                
                // Stop if we've reached the end of this basic block
                if pc < bytecode.len() && cfg.is_jump_destination(pc) && pc != block_start {
                    break;
                }
            }
        }
        
        (external_calls, security_warnings)
    }
    
    /// Calculate the maximum memory usage based on memory accesses
    pub fn calculate_max_memory(&self) -> usize {
        let mut max_memory = 0;
        
        // Get all memory accesses from the memory analyzer
        let memory_accesses = self.memory_analyzer.get_accesses();
        
        // Calculate the maximum memory usage by finding the highest offset + size
        for access in memory_accesses {
            // Safely convert U256 to usize, capping at usize::MAX if necessary
            let offset = if access.offset > U256::from(usize::MAX) {
                usize::MAX
            } else {
                access.offset.as_usize()
            };
            
            let size = if access.size > U256::from(usize::MAX) {
                usize::MAX
            } else {
                access.size.as_usize()
            };
            
            // Calculate the end of this memory access with overflow protection
            let end = if offset > usize::MAX - size {
                usize::MAX  // Saturate at maximum value
            } else {
                offset + size
            };
            
            // Update max_memory if this access extends beyond current max
            if end > max_memory {
                max_memory = end;
            }
        }
        
        // Round up to the nearest multiple of 32 bytes (word size in EVM)
        let word_size = 32;
        let remainder = max_memory % word_size;
        if remainder > 0 {
            // Ensure we don't overflow when rounding up
            if max_memory > usize::MAX - (word_size - remainder) {
                max_memory = usize::MAX;
            } else {
                max_memory += word_size - remainder;
            }
        }
        
        max_memory
    }

    /// Detect arithmetic overflow vulnerabilities in the bytecode
    fn detect_overflow(&self) -> Result<Vec<SecurityWarning>> {
        // Call our enhanced implementation for better detection
        self.detect_arithmetic_overflow_enhanced()
    }
    

    /// Detect vulnerabilities related to DELEGATECALL usage using stack simulation
    fn detect_delegate_call_vulnerabilities(&self) -> Result<Vec<SecurityWarning>> {
        let mut security_warnings = Vec::new();
        let bytecode_vec: Vec<u8> = self.bytecode.iter().copied().collect();
        
        // Simplified implementation - just check for DELEGATECALL opcode
        for i in 0..bytecode_vec.len() {
            if bytecode_vec[i] == 0xF4 { // DELEGATECALL opcode
                let pc = i;
                
                // Add high-severity warning for delegate calls
                let call_operation = Operation::DelegateCall {
                    target: H256::zero(), // Simplified - we don't track actual targets
                    data: Vec::new(),   // Simplified - we don't track call data
                };
                
                // Add high-severity warning for all delegate calls
                security_warnings.push(SecurityWarning {
                    kind: SecurityWarningKind::UnprotectedDelegateCall,
                    severity: SecuritySeverity::High,
                    pc: pc as u64,
                    description: format!(
                        "Potentially unsafe delegate call at PC {}. Delegate calls can lead to unexpected behavior if the target contract is malicious or upgraded.",
                        pc
                    ),
                    operations: vec![call_operation.clone()],
                    remediation: String::from(
                        "Ensure that the target address for delegate calls is a trusted contract that cannot be changed. Consider using a whitelist of allowed addresses."
                    ),
                });
                
                // Simplified - add a generic context confusion warning for all DELEGATECALL opcodes
                security_warnings.push(SecurityWarning {
                    kind: SecurityWarningKind::DelegateCallContextConfusion,
                    severity: SecuritySeverity::High,
                    pc: pc as u64,
                    description: format!(
                        "Potential delegate call context confusion at PC {}. The delegate call may access storage variables that have different meanings in different contracts.",
                        pc
                    ),
                    operations: vec![call_operation],
                    remediation: String::from(
                        "Be extremely cautious with storage access in contracts meant to be called via delegatecall. Consider using a specific storage slot pattern that avoids collisions."
                    ),
                });
            }
        }
        
        // Check for delegate calls in constructor code
        self.check_constructor_delegate_calls(&bytecode_vec, &mut security_warnings)?;
        
        Ok(security_warnings)
    }






























































































































































