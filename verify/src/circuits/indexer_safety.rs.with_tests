        // Regular circuit with vulnerabilities should fail
        let circuit = IndexerSafetyCircuit::<Fr>::new_with_vulnerabilities(vulnerabilities.clone(), false);
        let cs = ark_relations::r1cs::ConstraintSystem::<Fr>::new_ref();
        assert!(circuit.generate_constraints(cs.clone()).is_err(), "Circuit with vulnerabilities should fail constraints");
        
        // Circuit in test mode should pass
        let test_circuit = IndexerSafetyCircuit::<Fr>::new_with_vulnerabilities(vulnerabilities, true);
        let test_cs = ark_relations::r1cs::ConstraintSystem::<Fr>::new_ref();
        assert!(test_circuit.generate_constraints(test_cs.clone()).is_ok(), "Circuit in test mode should pass constraints");
        
        Ok(())
    }
}

/// Detect excessive memory usage
fn detect_excessive_memory_usage(module: &Module, vulnerabilities: &mut Vec<IndexerVulnerability>) {
    detect_excessive_memory_usage_with_params(module, vulnerabilities, 100); // Default 100 pages (6.4MB)
}

/// Detect excessive memory usage with custom parameters
fn detect_excessive_memory_usage_with_params(
    module: &Module,
    vulnerabilities: &mut Vec<IndexerVulnerability>,
    max_pages: u32,
) {
    // Check for memory sections with large initial or maximum sizes
    for memory in module.memories() {
        let initial = memory.initial();
        let maximum = memory.maximum().unwrap_or(u32::MAX);
        
        if initial > max_pages {
            vulnerabilities.push(IndexerVulnerability::ExcessiveMemoryUsage(
                format!("Memory initialized with {} pages ({}MB), which exceeds the recommended maximum of {} pages ({}MB)",
                    initial, (initial as f32 * 0.064), max_pages, (max_pages as f32 * 0.064))
            ));
        }
        
        if maximum > max_pages * 2 {
            vulnerabilities.push(IndexerVulnerability::ExcessiveMemoryUsage(
                format!("Memory can grow to {} pages ({}MB), which exceeds the recommended maximum of {} pages ({}MB)",
                    maximum, (maximum as f32 * 0.064), max_pages * 2, (max_pages as f32 * 2.0 * 0.064))
            ));
        }
    }
    
    // Check for memory.grow operations that could lead to excessive memory
    for function in module.funcs().iter() {
        let name = function.name().unwrap_or("<unnamed>").to_string();
        let mut has_memory_grow = false;
        let mut has_bounded_grow = false;
        
        if let Some(code) = function.kind().code() {
            for block in code.blocks() {
                for (instr, _) in &block.instrs {
                    let instr_str = format!("{:?}", instr).to_lowercase();
                    
                    if instr_str.contains("memory.grow") {
                        has_memory_grow = true;
                    }
                    
                    // Check for comparison against a constant before memory.grow
                    // This is a common pattern for bounded growth
                    if instr_str.contains("i32.const") && 
                       (instr_str.contains("i32.lt") || instr_str.contains("i32.le") || 
                        instr_str.contains("i32.gt") || instr_str.contains("i32.ge")) {
                        has_bounded_grow = true;
                    }
                }
            }
        }
        
        // If we have memory.grow without bounds checking, flag it
        if has_memory_grow && !has_bounded_grow {
            vulnerabilities.push(IndexerVulnerability::ExcessiveMemoryUsage(
                format!("Function '{}' contains unbounded memory.grow operations that could consume excessive memory", name)
            ));
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use walrus::ModuleConfig;
    use wat::parse_str;
    use ark_bls12_381::Fr;
    use anyhow::Result;
    
    #[test]
    fn test_detect_unbounded_loops() -> Result<()> {
        let wat = r#"
            (module
                (func $infinite_loop
                    (loop
                        br 0  ;; Branch back to the beginning of the loop
                    )
                )
                (export "infinite_loop" (func $infinite_loop))
            )
        "#;
        
        let wasm = wat::parse_str(wat)?;
        let module = Module::from_buffer(&wasm)?;
        
        let mut vulnerabilities = Vec::new();
        detect_unbounded_loops(&module, &mut vulnerabilities);
        
        assert!(!vulnerabilities.is_empty(), "Should detect unbounded loop vulnerability");
        assert!(matches!(vulnerabilities[0], IndexerVulnerability::UnboundedLoop(_)));
        
        Ok(())
    }
    
    #[test]
    fn test_detect_unpredictable_execution() -> Result<()> {
        let wat = r#"
            (module
                (func $crypto_verify (param i32 i32) (result i32)
                    (local i32)
                    
                    ;; Data-dependent control flow pattern
                    local.get 0
                    local.get 1
                    i32.eq
                    if
                        i32.const 1
                        local.set 2
                    else
                        i32.const 0
                        local.set 2
                    end
                    
                    ;; Variable memory access pattern
                    local.get 0
                    i32.load
                    
                    local.get 2
                    i32.add
                )
                (memory 1)
                (export "crypto_verify" (func $crypto_verify))
            )
        "#;
        
        let wasm = wat::parse_str(wat)?;
        let module = Module::from_buffer(&wasm)?;
        
        let mut vulnerabilities = Vec::new();
        detect_unpredictable_execution(&module, &mut vulnerabilities);
        
        assert!(!vulnerabilities.is_empty(), "Should detect unpredictable execution vulnerability");
        assert!(matches!(vulnerabilities[0], IndexerVulnerability::UnpredictableExecution(_)));
        
        Ok(())
    }
    
    #[test]
    fn test_detect_crypto_suggestive_names() -> Result<()> {
        let wat = r#"
            (module
                (func $encrypt_data (param i32 i32) (result i32)
                    ;; Use call_indirect which is an unpredictable operation
                    local.get 0
                    local.get 1
                    call_indirect (type 0)
                )
                (table 1 funcref)
                (type (func (param i32 i32) (result i32)))
                (export "encrypt_data" (func $encrypt_data))
            )
        "#;
        
        let wasm = wat::parse_str(wat)?;
        let module = Module::from_buffer(&wasm)?;
        
        let mut vulnerabilities = Vec::new();
        detect_unpredictable_execution(&module, &mut vulnerabilities);
        
        assert!(!vulnerabilities.is_empty(), "Should detect crypto-suggestive name with unpredictable ops");
        assert!(matches!(vulnerabilities[0], IndexerVulnerability::UnpredictableExecution(_)));
        
        // The vulnerability should mention 'cryptographic context'
        if let IndexerVulnerability::UnpredictableExecution(msg) = &vulnerabilities[0] {
            assert!(msg.contains("cryptographic context"), "Vulnerability message should mention cryptographic context");
        }
        
        Ok(())
    }
    
    #[test]
    fn test_detect_floating_point_in_loop() -> Result<()> {
        let wat = r#"
            (module
                (func $float_compute (param f32) (result f32)
                    (local i32 f32)
                    
                    ;; Initialize counter
                    i32.const 0
                    local.set 1
                    
                    ;; Initialize result
                    local.get 0
                    local.set 2
                    
                    ;; Loop with floating point operations
                    (loop
                        local.get 2
                        f32.const 1.1
                        f32.mul
                        local.set 2
                        
                        local.get 1
                        i32.const 1
                        i32.add
                        local.set 1
                        
                        local.get 1
                        i32.const 10
                        i32.lt_s
                        br_if 0
                    )
                    
                    local.get 2
                )
                (export "float_compute" (func $float_compute))
            )
        "#;
        
        let wasm = wat::parse_str(wat)?;
        let module = Module::from_buffer(&wasm)?;
        
        let mut vulnerabilities = Vec::new();
        detect_unpredictable_execution(&module, &mut vulnerabilities);
        
        assert!(!vulnerabilities.is_empty(), "Should detect floating point in loop vulnerability");
        assert!(matches!(vulnerabilities[0], IndexerVulnerability::UnpredictableExecution(_)));
        
        // The vulnerability should mention 'floating point'
        if let IndexerVulnerability::UnpredictableExecution(msg) = &vulnerabilities[0] {
            assert!(msg.contains("floating point"), "Vulnerability message should mention floating point operations");
        }
        
        Ok(())
    }
    
    #[test]
    fn test_detect_direct_recursion() -> Result<()> {
        let wat = r#"
            (module
                (func $factorial (param i32) (result i32)
                    ;; if n <= 1 return 1, else return n * factorial(n-1)
                    local.get 0
                    i32.const 1
                    i32.le_s
                    if
                        i32.const 1
                        return
                    end
                    
                    local.get 0
                    local.get 0
                    i32.const 1
                    i32.sub
                    call $factorial
                    i32.mul
                )
                (export "factorial" (func $factorial))
            )
        "#;
        
        let wasm = wat::parse_str(wat)?;
        let module = Module::from_buffer(&wasm)?;
        
        let mut vulnerabilities = Vec::new();
        detect_complex_recursion(&module, &mut vulnerabilities);
        
        assert!(!vulnerabilities.is_empty(), "Should detect direct recursion vulnerability");
        assert!(matches!(vulnerabilities[0], IndexerVulnerability::ComplexRecursion(_)));
        
        // The vulnerability should mention 'directly calls itself'
        if let IndexerVulnerability::ComplexRecursion(msg) = &vulnerabilities[0] {
            assert!(msg.contains("directly calls itself"), "Vulnerability message should mention direct recursion");
        }
        
        Ok(())
    }
    
    #[test]
    fn test_mutual_recursion() -> Result<()> {
        let wat = r#"
            (module
                (func $is_even (param i32) (result i32)
                    local.get 0
                    i32.eqz
                    if
                        i32.const 1  ;; 0 is even
                        return
                    end
                    
                    local.get 0
                    i32.const 1
                    i32.sub
                    call $is_odd
                )
                
                (func $is_odd (param i32) (result i32)
                    local.get 0
                    i32.eqz
                    if
                        i32.const 0  ;; 0 is not odd
                        return
                    end
                    
                    local.get 0
                    i32.const 1
                    i32.sub
                    call $is_even
                )
                
                (export "is_even" (func $is_even))
                (export "is_odd" (func $is_odd))
            )
        "#;
        
        let wasm = wat::parse_str(wat)?;
        let module = Module::from_buffer(&wasm)?;
        
        let mut vulnerabilities = Vec::new();
        detect_complex_recursion(&module, &mut vulnerabilities);
        
        assert!(!vulnerabilities.is_empty(), "Should detect mutual recursion vulnerability");
        assert!(matches!(vulnerabilities[0], IndexerVulnerability::ComplexRecursion(_)));
        
        // At least one of the vulnerabilities should mention 'recursive call cycle'
        let has_cycle_message = vulnerabilities.iter().any(|v| {
            if let IndexerVulnerability::ComplexRecursion(msg) = v {
                msg.contains("recursive call cycle")
            } else {
                false
            }
        });
        
        assert!(has_cycle_message, "At least one vulnerability message should mention recursive call cycle");
        
        Ok(())
    }
    
    #[test]
    fn test_indexer_safety_circuit_constraints() -> Result<()> {
        let vulnerabilities = vec![
            IndexerVulnerability::UnboundedLoop("Test unbounded loop".to_string()),
            IndexerVulnerability::UnpredictableExecution("Test unpredictable execution".to_string()),
        ];
        
        // Regular circuit with vulnerabilities should fail
        let circuit = IndexerSafetyCircuit::<Fr>::new_with_vulnerabilities(vulnerabilities.clone(), false);
        let cs = ark_relations::r1cs::ConstraintSystem::<Fr>::new_ref();
        assert!(circuit.generate_constraints(cs.clone()).is_err(), "Circuit with vulnerabilities should fail constraints");
        
        // Circuit in test mode should pass
        let test_circuit = IndexerSafetyCircuit::<Fr>::new_with_vulnerabilities(vulnerabilities, true);
        let test_cs = ark_relations::r1cs::ConstraintSystem::<Fr>::new_ref();
        assert!(test_circuit.generate_constraints(test_cs.clone()).is_ok(), "Circuit in test mode should pass constraints");
        
        Ok(())
    }
}

/// Analyze a WebAssembly module for indexer vulnerabilities
pub fn analyze_indexer_vulnerabilities(module: &Module) -> Vec<IndexerVulnerability> {
    let mut vulnerabilities = Vec::new();

    // Perform each type of vulnerability detection
    detect_unbounded_loops(module, &mut vulnerabilities);
    detect_unpredictable_fuel_consumption(module, &mut vulnerabilities);
    detect_excessive_memory_usage(module, &mut vulnerabilities);
    detect_unpredictable_execution(module, &mut vulnerabilities);
    detect_complex_recursion(module, &mut vulnerabilities);

    vulnerabilities
}

/// Analyze a WebAssembly module for indexer vulnerabilities with options
pub fn analyze_indexer_vulnerabilities_with_options(
    module: &Module,
    max_loop_iterations: u32,
    max_memory_pages: u32,
    test_mode: bool,
) -> Vec<IndexerVulnerability> {
    if test_mode {
        return Vec::new(); // Skip analysis in test mode
    }

    let mut vulnerabilities = Vec::new();

    // Perform each type of vulnerability detection with custom parameters
    detect_unbounded_loops_with_params(module, &mut vulnerabilities, max_loop_iterations);
    detect_unpredictable_fuel_consumption(module, &mut vulnerabilities);
    detect_excessive_memory_usage_with_params(module, &mut vulnerabilities, max_memory_pages);
    detect_unpredictable_execution(module, &mut vulnerabilities);
    detect_complex_recursion(module, &mut vulnerabilities);

    vulnerabilities
}

/// Detect unbounded loops that could stall the indexer
fn detect_unbounded_loops(module: &Module, vulnerabilities: &mut Vec<IndexerVulnerability>) {
    detect_unbounded_loops_with_params(module, vulnerabilities, 1000); // Default 1000 max iterations
}

/// Detect unbounded loops with custom parameters
fn detect_unbounded_loops_with_params(
    module: &Module, 
    vulnerabilities: &mut Vec<IndexerVulnerability>,
    max_iterations: u32,
) {
    // Keywords that suggest loop constructs in function names or debug info
    let loop_keywords = ["loop", "while", "for", "repeat", "iter"];
    
    for function in module.funcs().iter() {
        let name = if let Some(name) = function.name() {
            name.to_string()
        } else {
            "<unnamed>".to_string()
        };
        
        if let Some(code) = function.kind().code() {
            // Check for loop instructions
            let mut has_loop = false;
            let mut has_bounded_counter = false;
            let mut has_clear_termination = false;
            
            for (idx, block) in code.blocks().iter().enumerate() {
                // Look for loop instructions
                for (instr, _) in &block.instrs {
                    let instr_str = format!("{:?}", instr).to_lowercase();
                    
                    // Check if this is a loop construct
                    if instr_str.contains("loop") {
                        has_loop = true;
                    }
                    
                    // Check if there's a branch condition that could terminate the loop
                    if instr_str.contains("br_if") || instr_str.contains("br_table") {
                        has_clear_termination = true;
                    }
                    
                    // Check if there's a counter being incremented (common in bounded loops)
                    if (instr_str.contains("local.get") && instr_str.contains("i32.add") && 
                        instr_str.contains("local.set")) ||
                       (instr_str.contains("local.get") && instr_str.contains("i32.const") && 
                        instr_str.contains("i32.lt")) {
                        has_bounded_counter = true;  
                    }
                }
            }
            
            // If we found a loop without clear termination or bounded counter, flag it
            if has_loop && (!has_clear_termination || !has_bounded_counter) {
                vulnerabilities.push(IndexerVulnerability::UnboundedLoop(
                    format!("Function '{}' contains a potentially unbounded loop that could stall the Alkanes indexer", name)
                ));
            }
        }
    }
}

