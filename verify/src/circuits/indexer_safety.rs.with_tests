/// Detect unpredictable fuel consumption patterns
fn detect_unpredictable_fuel_consumption(module: &Module, vulnerabilities: &mut Vec<IndexerVulnerability>) {
    // Operations that are particularly expensive in terms of fuel
    let fuel_intensive_ops = [
        "call", "call_indirect", "memory.grow", "memory.fill", "memory.copy", 
        "table.get", "table.set", "table.grow", "table.fill", "table.copy"
    ];
    
    for function in module.funcs().iter() {
        let name = function.name().unwrap_or("<unnamed>").to_string();
        let mut has_conditional_intensive_ops = false;
        let mut has_data_dependent_call = false;
        let mut has_fuel_intensive_loop = false;
        
        if let Some(code) = function.kind().code() {
            // Track if we're inside a conditional block
            let mut in_conditional = false;
            let mut in_loop = false;
            
            for block in code.blocks() {
                for (instr, _) in &block.instrs {
                    let instr_str = format!("{:?}", instr).to_lowercase();
                    
                    // Check for loop or conditional structures
                    if instr_str.contains("if") || instr_str.contains("block") {
                        in_conditional = true;
                    } else if instr_str.contains("end") {
                        in_conditional = false;
                        in_loop = false;
                    } else if instr_str.contains("loop") {
                        in_loop = true;
                    }
                    
                    // Check for fuel-intensive operations in conditional blocks
                    if in_conditional && fuel_intensive_ops.iter().any(|op| instr_str.contains(op)) {
                        has_conditional_intensive_ops = true;
                    }
                    
                    // Check for fuel-intensive operations in loops
                    if in_loop && fuel_intensive_ops.iter().any(|op| instr_str.contains(op)) {
                        has_fuel_intensive_loop = true;
                    }
                    
                    // Check for data-dependent call patterns
                    if (instr_str.contains("call") || instr_str.contains("call_indirect")) && 
                       (instr_str.contains("local.get") || instr_str.contains("global.get")) {
                        has_data_dependent_call = true;
                    }
                }
            }
        }
        
        // Report vulnerabilities based on detected patterns
        if has_conditional_intensive_ops {
            vulnerabilities.push(IndexerVulnerability::UnpredictableFuelConsumption(
                format!("Function '{}' has fuel-intensive operations in conditional blocks, which can cause unpredictable fuel consumption", name)
            ));
        }
        
        if has_fuel_intensive_loop {
            vulnerabilities.push(IndexerVulnerability::UnpredictableFuelConsumption(
                format!("Function '{}' has fuel-intensive operations in loops, which can cause excessive fuel consumption", name)
            ));
        }
        
        if has_data_dependent_call {
            vulnerabilities.push(IndexerVulnerability::UnpredictableFuelConsumption(
                format!("Function '{}' has data-dependent call patterns that can lead to unpredictable fuel consumption", name)
            ));
        }
    }
}

