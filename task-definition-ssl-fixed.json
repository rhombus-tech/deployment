{
  "family": "zkvm-server-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::586794479606:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::586794479606:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "zkvm-server",
      "image": "586794479606.dkr.ecr.us-east-1.amazonaws.com/zkvm-api:glibc-fixed",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp",
          "hostPort": 8080
        }
      ],
      "environment": [
        {
          "name": "PORT",
          "value": "8080"
        },
        {
          "name": "RUST_LOG",
          "value": "info"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/zkvm-server",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
