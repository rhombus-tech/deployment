# Docker ignore file for optimized builds
target/
.git/
.gitignore
README.md
*.md
.env*
.vscode/
.idea/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test files
**/tests/
**/*_test.rs
**/*_test.go

# Temporary files
*.tmp
*.log
*.pid
*.seed
*.cache

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Development artifacts
coverage/
.nyc_output/
*.prof
*.trace

# Build artifacts (except the ones we need)
*.dSYM/
*.so
*.dylib
*.dll
*.exe
*.test
*.out

