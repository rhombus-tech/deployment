# FRAC RPC Configuration

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8545
SERVER_WORKERS=4

# Your Own Erigon Archive Nodes (Primary)
ERIGON_PRIMARY_URL=http://localhost:8545
ERIGON_SECONDARY_URL=http://localhost:8547

# Geth Full Node (Validation)
GETH_URL=http://localhost:8548

# PostgreSQL L2 Cache
DATABASE_URL=postgresql://frac:fracpassword@localhost:5432/frac_rpc
POSTGRES_PASSWORD=fracpassword

# Redis L1 Cache
REDIS_URL=redis://localhost:6379

# Fallback Providers (for redundancy)
ALCHEMY_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
INFURA_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID

# Geographic Routing (Multi-Region)
ENABLE_GEO_ROUTING=false
REGION=us-east-1

# Monitoring
LOG_LEVEL=info
ENABLE_METRICS=true
