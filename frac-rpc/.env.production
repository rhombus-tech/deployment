# FRAC RPC Production Configuration
# For zkEVM Proving Infrastructure

# ============================================
# SERVER CONFIGURATION
# ============================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8545
LOG_LEVEL=info

# ============================================
# PRIMARY INFRASTRUCTURE (YOUR NODES - 90% traffic)
# ============================================
# Your Erigon Archive Nodes (Primary infrastructure)
ERIGON_PRIMARY_URL=http://erigon-primary:8545
ERIGON_SECONDARY_URL=http://erigon-secondary:8545
GETH_URL=http://geth:8545

# Node Configuration
NODE_REQUEST_TIMEOUT_SECS=30
NODE_HEALTH_CHECK_INTERVAL_SECS=60

# ============================================
# EXTERNAL FALLBACKS (10% traffic - emergency only)
# ============================================
# Get free API keys from:
# Alchemy: https://dashboard.alchemy.com (300M compute units/month free)
# Infura: https://infura.io/dashboard (100k requests/day free)

ALCHEMY_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY_HERE
INFURA_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY_HERE

# ============================================
# CACHE CONFIGURATION (4-Tier)
# ============================================
# L1: In-memory cache (DashMap)
MEMORY_CACHE_TTL_SECS=300

# L2: Redis distributed cache
REDIS_URL=redis://redis:6379
REDIS_MAX_CONNECTIONS=10
CACHE_TTL_SECS=300

# L3: PostgreSQL historical cache
POSTGRES_URL=postgresql://frac:fracpassword@postgres:5432/frac_rpc
POSTGRES_MAX_CONNECTIONS=10

# ============================================
# RATE LIMITING & DDOS PROTECTION
# ============================================
RATE_LIMIT_REQUESTS_PER_MINUTE=1000
RATE_LIMIT_WINDOW_SECS=60
RATE_LIMIT_BURST_SIZE=20

# ============================================
# PROVING OPTIMIZATIONS
# ============================================
# Batch proving data requests
PROVING_BATCH_SIZE=10
PROVING_PREFETCH_ENABLED=true
PROVING_PARALLEL_FETCH=true

# ============================================
# CIRCUIT BREAKER CONFIGURATION
# ============================================
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT_SECS=30
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2

# ============================================
# MONITORING
# ============================================
METRICS_ENABLED=true
METRICS_PORT=9090
PROMETHEUS_ENABLED=true
