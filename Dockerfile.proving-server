# Multi-stage build for optimized production image
FROM rust:1.75-slim AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY evm-verify ./evm-verify
COPY stateless-vm ./stateless-vm
COPY trustless-proving-server ./trustless-proving-server

# Build release binary
RUN cargo build --release --bin trustless-proving-server

# Production stage
FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -u 1000 prover && \
    mkdir -p /app/data && \
    chown -R prover:prover /app

WORKDIR /app

# Copy binary from builder
COPY --from=builder /build/target/release/trustless-proving-server /app/

# Copy configuration
COPY trustless-proving-server/config /app/config

USER prover

# Expose API port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:3000/health || exit 1

# Environment variables
ENV RUST_LOG=info
ENV ENABLE_FRACTAL=true

CMD ["/app/trustless-proving-server"]
